# Nemo Tracker — Configuration
# Copy this file to .env and fill in your values

# === Marzban Connection ===
MARZBAN_URL=https://your-marzban-panel.com
MARZBAN_ADMIN_USERNAME=admin
MARZBAN_ADMIN_PASSWORD=your_password

# === Xray Logs (optional, for real-time tracking) ===
XRAY_ACCESS_LOG=/var/lib/marzban/access.log
XRAY_ERROR_LOG=/var/lib/marzban/error.log

# === Database ===
DATABASE_URL=postgresql+asyncpg://nemo_tracker:your_password@localhost:5432/nemo_tracker

# === Telegram Bot ===
BOT_TOKEN=your_telegram_bot_token
ADMIN_IDS=123456789,987654321

# === Web Dashboard ===
WEB_HOST=0.0.0.0
WEB_PORT=8080
WEB_SECRET_KEY=change-this-to-a-random-string

# === Tracking Settings ===
DEVICE_CHECK_INTERVAL=60        # seconds between IP checks
AUTO_BLOCK_ON_LIMIT=true        # auto-disable user when device limit exceeded
NOTIFY_ON_NEW_DEVICE=true       # send Telegram notification on new device
NOTIFY_ON_LIMIT_EXCEEDED=true   # send Telegram notification on limit exceeded

# === Device Tracking Rules ===
# Which inbound tags to track (comma-separated)
TRACK_INBOUNDS=vless-reality-whitelist
# Which inbound tags to NEVER track (comma-separated)
IGNORE_INBOUNDS=vless-reality-standard
# Proxy/server IPs to ignore (comma-separated)
IGNORED_IPS=
# Only enforce limits on users with device_count > 0 (skip legacy unlimited users)
ONLY_ENFORCE_WITH_LIMIT=true

# === GeoIP (optional, for IP geolocation) ===
GEOIP_DB_PATH=./data/GeoLite2-City.mmdb
